# Redirect /home to root
/home / 301

# Handle trailing slashes
/shop/ /shop.html 301
/gallery/ /gallery.html 301

# Handle old URLs (if any)
/index /index.html 301

# Association files
/.well-known/apple-app-site-association /.netlify/functions/apple-app-site-association 200!

# Shared/deep-link web fallbacks
/events/:eventId /share-fallback.html 200!
/events/* /share-fallback.html 200!
/event/:eventId /share-fallback.html 200!
/event/* /share-fallback.html 200!
/courts/:courtId /share-fallback.html 200!
/courts/* /share-fallback.html 200!
/court/:courtId /share-fallback.html 200!
/court/* /share-fallback.html 200!
/profile/:userId /share-fallback.html 200!
/profile/* /share-fallback.html 200!
/profiles/:userId /share-fallback.html 200!
/profiles/* /share-fallback.html 200!

# Unknown routes fall through to the deep-link fallback renderer.
/* /share-fallback.html 200
